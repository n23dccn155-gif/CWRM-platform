# Giá trị mẫu để chạy trên máy cá nhân; không dùng cho môi trường triển khai.

# Cấu hình ứng dụng
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Tài khoản PostgreSQL dùng riêng cho Docker Compose trên máy cá nhân
POSTGRES_USER=cwrm
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=cwrm_dev
# Cổng trên máy thật; dùng 5433 để không đụng PostgreSQL khác đang chiếm 5432
POSTGRES_PORT=5433

# URL phải khớp các giá trị PostgreSQL ở trên
DATABASE_URL=postgresql://cwrm:change_me_local_only@localhost:5433/cwrm_dev?schema=public

# Mật khẩu chung của ba tài khoản demo, chỉ dùng trong dữ liệu seed máy cá nhân
SEED_DEMO_PASSWORD=change_me_demo_only
BCRYPT_COST=10
